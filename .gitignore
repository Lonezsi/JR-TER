# Your library: the database and every file you have uploaded.
data/

# Copies of it made by hand before something risky. Ignored so that leaving one lying
# about does not make the checkout look modified, which the updater used to read as
# "somebody has edited JR!TER" and refuse to pull.
data-backup*/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Editors and systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# The agent's local settings
client.json

# Written by install.ps1 into whatever directory it installed to. It holds the path to
# that machine's Python, so it is a local file rather than part of the project.
JR-TER.cmd

# Written by web/img/make-favicon.py --preview, to look at the icon at three sizes at once.
# Regenerable with one command, and it would otherwise be served as part of the app.
web/img/favicon-preview.png
